---
import { now } from "../data/site";
---

<section class="section">
  <h2 data-reveal>Now</h2>
  <div class="body rows">
    {
      now.map((n) => (
        <div class="row" data-reveal>
          <div class="mono label">{n.label}</div>
          <div class="text">{n.text}</div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .row {
    padding: 22px 0;
    display: grid;
    grid-template-columns: minmax(0, 130px) minmax(0, 1fr);
    gap: clamp(14px, 2vw, 28px);
    align-items: baseline;
  }

  .text {
    font-size: clamp(16px, 1.6vw, 19px);
    font-weight: 300;
    line-height: 1.5;
    color: oklch(0.28 0.004 100);
  }
</style>
