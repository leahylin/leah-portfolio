<script>
  // Scroll-driven effects. No animation library — one listener, one pass.
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const nav = document.getElementById("nav");
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const heroAside = document.querySelector<HTMLElement>("[data-hero-aside]");

  function runCount(el: HTMLElement, instant: boolean) {
    const to = parseFloat(el.dataset.count || "");
    if (Number.isNaN(to)) return;
    const dec = parseInt(el.dataset.countDecimals || "0", 10);
    const suf = el.dataset.countSuffix || "";
    const write = (v: number) => (el.textContent = v.toFixed(dec) + suf);
    if (instant) return write(to);
    const t0 = performance.now();
    const tick = (now: number) => {
      const t = Math.min((now - t0) / 1100, 1);
      write(to * (1 - Math.pow(1 - t, 3)));
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  function frame() {
    const y = window.scrollY;
    const vh = window.innerHeight || 1;

    nav?.classList.toggle("is-stuck", y > 50);

    if (reduced) return;

    if (hero) {
      const p = Math.min(y / (vh * 0.85), 1);
      hero.style.transform = `translate3d(0,${y * 0.2}px,0)`;
      hero.style.opacity = String(1 - p * 0.85);
    }
    if (heroAside) heroAside.style.transform = `translate3d(0,${y * -0.16}px,0)`;

    document.querySelectorAll<HTMLElement>("[data-parallax]").forEach((el) => {
      const f = parseFloat(el.dataset.parallax || "0");
      const r = el.getBoundingClientRect();
      el.style.transform = `translate3d(0,${((r.top - vh * 0.62) * f).toFixed(2)}px,0)`;
    });

    // Pinned horizontal project rail
    document.querySelectorAll<HTMLElement>("[data-hscroll]").forEach((wrap) => {
      const track = wrap.querySelector<HTMLElement>("[data-hscroll-track]");
      if (!track) return;
      const span = Math.max(wrap.offsetHeight - vh, 1);
      const prog = Math.min(1, Math.max(0, -wrap.getBoundingClientRect().top / span));
      const dist = Math.max(0, track.scrollWidth - track.clientWidth);
      track.style.transform = `translate3d(${(-prog * dist).toFixed(1)}px,0,0)`;
      const bar = wrap.querySelector<HTMLElement>("[data-hscroll-bar]");
      if (bar) bar.style.width = `${(prog * 100).toFixed(1)}%`;
      const count = wrap.querySelector<HTMLElement>("[data-hscroll-count]");
      const n = track.children.length;
      if (count && n) {
        const i = Math.min(n, Math.round(prog * (n - 1)) + 1);
        count.textContent = `${String(i).padStart(2, "0")} / ${String(n).padStart(2, "0")}`;
      }
    });

    // Sequential pipeline reveal
    document.querySelectorAll<HTMLElement>("[data-pipeline]").forEach((wrap) => {
      const span = Math.max(wrap.offsetHeight - vh, 1);
      const prog = Math.min(1, Math.max(0, -wrap.getBoundingClientRect().top / span));
      const steps = wrap.querySelectorAll<HTMLElement>("[data-stage]");
      steps.forEach((el, i) =>
        el.classList.toggle("is-active", prog >= (i / steps.length) * 0.92)
      );
    });
  }

  // One-shot reveals + counters
  if (reduced) {
    document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => runCount(el, true));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          el.classList.add("is-in");
          if (el.dataset.count !== undefined) runCount(el, false);
          io.unobserve(el);
        }
      },
      { threshold: 0.25, rootMargin: "0px 0px -8% 0px" }
    );
    document.querySelectorAll("[data-reveal], [data-count]").forEach((el) => io.observe(el));
  }

  let queued = false;
  const onScroll = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      frame();
    });
  };

  addEventListener("scroll", onScroll, { passive: true });
  addEventListener("resize", onScroll, { passive: true });
  frame();
</script>
