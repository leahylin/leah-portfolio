---
import { education } from "../data/site";
---

<section class="section" id="about">
  <h2 data-reveal>About</h2>
  <div class="body">
    <div class="prose" data-reveal>
      <p>
        I am a Master's student in Computing at the Australian National University, 
        specialising in Artificial Intelligence and Machine Learning. 
        I expect to graduate in December 2026.
      </p>
      <p>
        With a background in applied data analytics and statistics, 
        I enjoy turning raw data and research ideas into machine learning models 
        and practical AI systems.
      </p>
      <p>
        My current interests include large language models, generative models, 
        AI agents, and planning, with a focus on building and experimenting with 
        practical AI applications.
      </p>
    </div>

    <div class="mono heading">Education</div>
    <div class="rows">
      {
        education.map((e) => (
          <div class="row" data-reveal>
            <div>
              <div class="school">{e.school}</div>
              <div class="degree">{e.degree}</div>
              {e.note && <div class="note">{e.note}</div>}
            </div>
            <div class="years">{e.years}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .prose {
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.62;
    font-weight: 300;
    color: oklch(0.28 0.004 100);
    display: grid;
    gap: 1.05em;
    max-width: 34em;
    text-wrap: pretty;
  }

  .prose p { margin: 0; }

  .heading { margin: clamp(34px, 4vw, 56px) 0 18px; letter-spacing: 0.18em; }

  .row {
    padding: 20px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 120px;
    gap: 20px;
    align-items: baseline;
  }

  .school { font-size: 17px; font-weight: 500; letter-spacing: -0.01em; }
  .degree { margin-top: 5px; font-size: 14.5px; font-weight: 300; color: var(--ink-2); }
  .note { margin-top: 8px; font-family: var(--mono); font-size: 12px; }
  .years { font-family: var(--mono); font-size: 12px; color: var(--ink-2); text-align: right; }
</style>
