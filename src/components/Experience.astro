---
import { experience } from "../data/site";
---

<section class="section">
  <h2 data-reveal>Experience</h2>
  <div class="body rows">
    {
      experience.map((e) => (
        <div class="row" data-reveal>
          <div class="year">{e.year}</div>
          <div>
            <div class="org">{e.org}</div>
            <div class="role">{e.role}</div>
            {e.detail && <p class="detail">{e.detail}</p>}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .row {
    padding: clamp(20px, 2.4vw, 28px) 0;
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr);
    gap: clamp(16px, 2vw, 32px);
    align-items: start;
  }

  .year { font-family: var(--mono); font-size: 12px; color: var(--ink-3); padding-top: 4px; }
  .org { font-size: clamp(17px, 1.8vw, 21px); font-weight: 500; letter-spacing: -0.015em; }
  .role { margin-top: 5px; font-size: 14.5px; font-weight: 300; color: var(--ink-2); }

  .detail {
    margin: 12px 0 0;
    max-width: 40em;
    font-size: 15px;
    line-height: 1.6;
    font-weight: 300;
    color: oklch(0.34 0.004 100);
    text-wrap: pretty;
  }
</style>
