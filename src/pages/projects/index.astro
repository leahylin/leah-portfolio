---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const entries = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Work — Leah Lin">
  <section class="head">
    <h1>Selected Work</h1>
    <p>Projects across language models, generative models, planning and computer vision.</p>
  </section>

  <div class="rows list">
    {
      entries.map((entry) => (
        <a class="row" href={`/projects/${entry.slug}`} data-reveal>
          <div class="num mono">{entry.data.number}</div>
          <div>
            <div class="mono kind">
              {entry.data.kind}{entry.data.demo ? " · Live demo" : ""}
            </div>
            <h2>{entry.data.title}</h2>
            <div class="sub">{entry.data.subtitle}</div>
          </div>
          <div>
            <div class="metric">{entry.data.metricLine}</div>
            <div class="tags mono">{entry.data.tags.join(" · ")}</div>
          </div>
          <div class="arrow">→</div>
        </a>
      ))
    }
  </div>
</Base>

<style>
  .head { padding: clamp(40px, 7vw, 100px) var(--pad) clamp(26px, 4vw, 46px); }

  h1 {
    margin: 0;
    font-size: clamp(34px, 6vw, 76px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .head p {
    margin: 20px 0 0;
    max-width: 30em;
    font-size: 16px;
    line-height: 1.6;
    font-weight: 300;
    color: var(--ink-2);
  }

  .list { margin: 0 var(--pad) clamp(60px, 9vw, 120px); }

  .row {
    display: grid;
    grid-template-columns: 54px minmax(0, 1.5fr) minmax(0, 1fr) 28px;
    gap: clamp(14px, 3vw, 40px);
    align-items: start;
    padding: clamp(22px, 3vw, 34px) clamp(6px, 1.4vw, 18px);
  }

  .row:hover { background: oklch(0.955 0.002 100); }

  .num { padding-top: 6px; letter-spacing: 0.1em; }
  .kind { letter-spacing: 0.18em; margin-bottom: 10px; }

  h2 {
    margin: 0;
    font-size: clamp(21px, 2.5vw, 31px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .sub { margin-top: 8px; font-size: 15px; font-weight: 300; color: var(--ink-2); }
  .metric { font-family: var(--mono); font-size: 13px; line-height: 1.7; }
  .tags { margin-top: 12px; letter-spacing: 0.08em; font-size: 11px; }
  .arrow { font-family: var(--mono); font-size: 15px; color: var(--ink-3); text-align: right; padding-top: 4px; }
</style>
