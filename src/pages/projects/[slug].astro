---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import StoryGenerator from "../../components/StoryGenerator";
import "../../components/StoryGenerator.css";

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  const sorted = entries.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, next: sorted[(i + 1) % sorted.length] },
  }));
}

const { entry, next } = Astro.props;
const p = entry.data;
const { Content } = await entry.render();

// Lets process content support lightweight **bold** highlighting for key
// terms/numbers (e.g. "success rate to **76.7%**") without pulling in a full
// markdown renderer for these short strings.
function highlight(text: string) {
  const escaped = text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
  return escaped.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
}
---

<Base title={`${p.title} — Leah Lin`} description={p.subtitle}>
  <article class={`project-${entry.slug}`}>
    <a class="back mono" href="/projects">← Back to work</a>

    <div class="hero">
      <div class="intro">
        <header>
          <div class="mono eyebrow">
            <span>{p.number} · {p.kind}</span>
          </div>
          <h1>{p.title}</h1>
          <p class="sub">{p.subtitle}</p>
        </header>

        <div class="actions">
          {
            p.report
              ? <a class="btn btn--solid" href={p.report} target="_blank" rel="noopener">View report ↗</a>
              : <a class="btn btn--solid" href={p.github}>View source code ↗</a>
          }
          {p.huggingface && <a class="btn" href={p.huggingface}>View on Hugging Face ↗</a>}
        </div>
      </div>

      {
        p.demo && (
          <div class="hero-demo">
            <div class="demo-heading">
              <div class="key">Try the model</div>
              <span class="mono badge">Live demo</span>
            </div>
            <StoryGenerator client:visible />
          </div>
        )
      }

      {
        !p.demo && p.heroImage && (
          <div class="hero-image">
            <img src={p.heroImage} alt={`${p.title} result figure`} loading="eager" />
          </div>
        )
      }
    </div>

    <div class="block">
      <div class="key">Overview</div>
      <p class="overview">{p.description}</p>
    </div>

    <div class="block">
      <div class="key">Results</div>
      <div class="metrics">
        {
          p.metrics.map((m) => (
            <div>
              <div class:list={["value", { "value--long": m.value.length > 8 || m.value.includes(" ") }]}>{m.value}</div>
              <div class="mono caption">{m.label}</div>
            </div>
          ))
        }
      </div>
    </div>

    {
      p.process && (
        <div class="block">
          <div class="key">Process</div>
          <div class="val process-flow">
            {
              p.processImage && (
                <button
                  type="button"
                  class="proc-overview-image"
                  data-lightbox-trigger
                  data-full={p.processImage}
                  aria-label="View larger process overview image"
                >
                  <img src={p.processImage} alt={`${p.title} process overview — click to view full size`} loading="lazy" />
                </button>
              )
            }
            {
              p.process.map((step, i) => (
                <>
                  <div class="proc-step">
                    <div class="proc-text">
                      <div class="mono proc-num">{step.num}</div>
                      <div class="proc-title">{step.title}</div>
                      <div class="proc-desc" set:html={highlight(step.desc)} />
                      {
                        step.setup && (
                          <div class="proc-setup">
                            <div class="proc-points-label mono">{step.setup.label}</div>
                            <ul class="proc-setup-items">
                              {step.setup.items.map((it) => <li set:html={highlight(it)} />)}
                            </ul>
                          </div>
                        )
                      }
                      {
                        step.pointGroups && step.pointGroups.map((group) => (
                          <div class="proc-group">
                            {group.label && <div class="proc-points-label mono">{group.label}</div>}
                            <ul class="proc-points">
                              {group.points.map((pt) => <li>→ <span set:html={highlight(pt)} /></li>)}
                            </ul>
                          </div>
                        ))
                      }
                      {
                        step.note && (
                          <div class="proc-note">
                            <div class="proc-points-label mono">{step.note.label}</div>
                            {step.note.lines.map((ln) => <p set:html={highlight(ln)} />)}
                          </div>
                        )
                      }
                    </div>
                    {
                      step.image && (
                        <button
                          type="button"
                          class="proc-image"
                          data-lightbox-trigger
                          data-full={step.image}
                          aria-label={`View larger image for ${step.title}`}
                        >
                          <img src={step.image} alt={`${step.title} result figure — click to view full size`} loading="lazy" />
                        </button>
                      )
                    }
                  </div>
                  {i < p.process!.length - 1 && <div class="proc-arrow" aria-hidden="true">↓</div>}
                </>
              ))
            }
          </div>
        </div>
      )
    }

    {
      p.specs && (
        <div class="block">
          <div class="key">Model</div>
          <div class="val rows specs">
            {
              p.specs.map((s) => (
                <div class="spec">
                  <div class="mono">{s.label}</div>
                  <div class="spec-value">{s.value}</div>
                </div>
              ))
            }
          </div>
        </div>
      )
    }

    {
      p.pipeline && (
        <div class="block">
          <div class="key">Approach</div>
          <div class="val flow">
            {
              p.pipeline.map((step, i) => (
                <div>
                  <div>{step}</div>
                  {i < p.pipeline!.length - 1 && <div class="arrow">↓</div>}
                </div>
              ))
            }
          </div>
        </div>
      )
    }

    {
      p.experiments && (
        <div class="block">
          <div class="key">Experiments</div>
          <div class="val rows specs exps">
            {
              p.experiments.map((x) => (
                <div class="spec">
                  <div class="mono">{x.label}</div>
                  <div class="spec-value">{x.value}</div>
                </div>
              ))
            }
          </div>
        </div>
      )
    }

    <div class="block">
      <div class="key">Stack</div>
      <div class="val chips">{p.tags.map((t) => <span class="chip">{t}</span>)}</div>
    </div>

    <div class="block">
      <div class="key">Notes</div>
      <div class="val prose"><Content /></div>
    </div>

    <nav class="pager">
      <a class="mono" href="/projects">← All projects</a>
      <a class="mono next" href={`/projects/${next.slug}`}>Next: {next.data.title} →</a>
    </nav>
  </article>

  <div id="lightbox" class="lightbox" hidden>
    <button type="button" class="lightbox-close" aria-label="Close">✕</button>
    <img id="lightbox-img" src="" alt="" />
  </div>
</Base>

<script>
  const lightbox = document.getElementById("lightbox") as HTMLDivElement | null;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
  const closeBtn = lightbox?.querySelector(".lightbox-close") as HTMLButtonElement | null;

  function openLightbox(src: string, alt: string) {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightbox.hidden = false;
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    if (!lightbox || !lightboxImg) return;
    lightbox.hidden = true;
    lightboxImg.src = "";
    document.body.style.overflow = "";
  }

  document.querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const full = btn.getAttribute("data-full");
      const img = btn.querySelector("img");
      if (full) openLightbox(full, img?.alt ?? "");
    });
  });

  closeBtn?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });
</script>

<style>
  article { padding: clamp(36px, 6vw, 80px) var(--pad) clamp(56px, 8vw, 110px); }

  .back { letter-spacing: 0.16em; font-size: 11.5px; }

  .hero {
    margin-top: clamp(30px, 5vw, 64px);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: clamp(110px, 9vw, 200px);
  }

  .intro {
    /* No flex-grow: without this the column was stretching to fill all
       leftover space, leaving a big empty gap before the demo box even
       though its own content (capped by header's max-width) stayed narrow. */
    flex: 0 1 24em;
    min-width: 0;
    /* Match the demo box's border + padding so its first line of text
       ("Try the model") lines up with the eyebrow row on the left. */
    padding-top: calc(clamp(24px, 3vw, 34px) + 1px);
  }

  header { max-width: 24em; }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    letter-spacing: 0.2em;
  }

  .badge { padding: 4px 9px; border: 1px solid var(--ink); color: var(--ink); }

  h1 {
    margin: 18px 0 0;
    font-size: clamp(34px, 6vw, 76px);
    line-height: 0.96;
    letter-spacing: -0.03em;
    font-weight: 500;
    text-wrap: balance;
  }

  .sub {
    margin: 20px 0 0;
    font-size: clamp(17px, 2vw, 24px);
    font-weight: 300;
    line-height: 1.34;
    color: oklch(0.42 0.004 100);
  }

  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: clamp(26px, 3.5vw, 42px); }

  .hero-demo {
    flex: 1 1 340px;
    max-width: 460px;
    min-width: 0;
    border: 1px solid var(--rule);
    padding: clamp(24px, 3vw, 34px);
  }

  .hero-image {
    flex: 1 1 340px;
    max-width: 440px;
    min-width: 0;
    align-self: center;
  }

  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .demo-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(14px, 2vw, 20px);
  }

  .hero-demo .key {
    font-size: clamp(15px, 1.6vw, 19px);
    margin-bottom: 0;
  }

  .block {
    margin-top: clamp(34px, 4vw, 56px);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(126px, 11vw, 190px);
    border-top: 1px solid var(--rule);
    padding-top: clamp(26px, 3vw, 40px);
  }

  /* Fixed, non-growing label column so every block's content starts at the
     exact same x, regardless of label length or how much free space the row has.
     Sized and weighted to match the homepage's section titles (.section > h2). */
  .key {
    flex: 0 1 200px;
    min-width: 0;
    align-self: flex-start;
    font-size: clamp(22px, 2.6vw, 34px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .val { flex: 1 1 0; min-width: 0; }

  .overview {
    flex: 1 1 0;
    min-width: 0;
    margin: 0;
    font-size: clamp(17px, 1.8vw, 22px);
    line-height: 1.58;
    font-weight: 300;
    color: oklch(0.26 0.004 100);
    max-width: 34em;
    text-wrap: pretty;
  }

  /* Vertical 01 -> 02 -> 03 -> 04 research-process list. */
  .process-flow {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.8vw, 22px);
    max-width: 48em;
  }

  .proc-step {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(20px, 3vw, 36px);
  }

  .proc-text { flex: 1 1 260px; min-width: 0; }

  .proc-image {
    display: block;
    flex: 0 1 220px;
    max-width: 220px;
    min-width: 140px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
  }

  .proc-image img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }

  .proc-image:hover img {
    opacity: 0.85;
    border-color: var(--rule-2);
  }

  .proc-overview-image {
    display: block;
    width: 100%;
    max-width: 100%;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
  }

  .proc-overview-image img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }

  .proc-overview-image:hover img {
    opacity: 0.85;
    border-color: var(--rule-2);
  }

  /* Reproduce is the 2nd step (3rd child of .process-flow, after its
     preceding arrow) — its figure reads busier than the others, so it's
     shown a bit smaller. */
  .project-flow-matching-meanflow .process-flow > .proc-step:nth-child(3) .proc-image {
    flex-basis: 150px;
    max-width: 150px;
    min-width: 110px;
  }

  .proc-num { margin-bottom: 6px; }

  .proc-title {
    font-size: clamp(15px, 1.6vw, 18px);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .proc-desc {
    margin-top: 6px;
    font-size: 13.5px;
    line-height: 1.5;
    font-weight: 300;
    color: var(--ink-2);
  }

  .proc-points-label {
    margin-top: 10px;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--ink-3);
    font-weight: 700;
  }

  .proc-group + .proc-group { margin-top: 14px; }

  .proc-setup { margin-top: 10px; }

  .proc-note { margin-top: 14px; max-width: 32em; }

  .proc-note p {
    margin: 4px 0 0;
    font-size: 13.5px;
    line-height: 1.5;
    font-weight: 300;
    color: var(--ink-2);
  }

  .proc-note p:first-of-type { margin-top: 6px; }

  .proc-points {
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .proc-points li {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .proc-desc strong,
  .proc-points li strong,
  .proc-note p strong,
  .proc-setup-items li strong {
    font-weight: 700;
    color: var(--ink);
  }

  .proc-setup-items {
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 30em;
  }

  .proc-setup-items li {
    font-size: 13px;
    line-height: 1.5;
    font-weight: 300;
    color: var(--ink-2);
  }

  .proc-arrow {
    flex: 0 0 auto;
    font-family: var(--mono);
    color: oklch(0.75 0.003 100);
  }

  /* Tighten just the gap between step 01 (Baseline) and 02 (Reproduce):
     this is the arrow between them, the 2nd child of .process-flow. */
  .process-flow > .proc-arrow:nth-child(2) {
    margin-top: -10px;
  }

  .metrics {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .metrics > div {
    background: var(--paper);
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
  }
  .metrics .value { font-family: var(--mono); font-size: clamp(20px, 2.4vw, 30px); letter-spacing: -0.02em; }

  /* Longer phrase-style results (as opposed to short numeric KPIs) read as
     oversized and awkward at the big mono KPI size, so they get a smaller,
     non-mono treatment instead. */
  .metrics .value--long {
    font-family: var(--sans);
    font-size: clamp(11px, 1.1vw, 13px);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    white-space: nowrap;
  }
  .metrics .caption { margin-top: auto; padding-top: 12px; }

  .specs { max-width: 40em; }

  .spec {
    padding: 14px 0;
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 20px;
    align-items: baseline;
  }

  .spec .mono { letter-spacing: 0.14em; font-size: 11px; }
  .spec-value { font-family: var(--mono); font-size: 13.5px; }

  .flow {
    font-family: var(--mono);
    font-size: clamp(12px, 1.3vw, 15px);
    line-height: 2.1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .flow .arrow { color: oklch(0.75 0.003 100); }

  .exps { max-width: 34em; }
  .exp { padding: 16px 0; font-family: var(--mono); font-size: 13px; letter-spacing: 0.04em; }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; align-self: flex-start; }

  .prose { font-size: 16.5px; line-height: 1.7; font-weight: 300; max-width: 34em; text-wrap: pretty; }
  .prose :global(p) { margin: 0 0 1em; }

  .pager {
    margin-top: clamp(48px, 7vw, 96px);
    border-top: 1px solid var(--rule);
    padding-top: clamp(22px, 3vw, 34px);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
  }

  .pager .mono { letter-spacing: 0.16em; font-size: 11.5px; }
  .pager .next { color: var(--ink); }

  /* Mobile: the fixed 200px label column + large label-content gap used on
     desktop leaves almost no room for content on narrow screens, so stack
     each block's label above its content instead, and let the demo box use
     the full width. */
  @media (max-width: 640px) {
    .hero { gap: 20px; }

    .hero-demo,
    .hero-image { flex-basis: 100%; max-width: 100%; }

    .block {
      flex-direction: column;
      gap: 10px;
    }

    .key { flex: 0 0 auto; }

    .val,
    .overview,
    .metrics,
    .process-flow { flex: 1 1 auto; max-width: none; }

    .proc-image { flex-basis: 100%; max-width: 220px; }

    .spec {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 10px 0;
    }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 5vw, 64px);
    background: oklch(0.15 0.004 100 / 0.92);
  }

  .lightbox[hidden] { display: none; }

  .lightbox img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    border: 1px solid var(--rule-2);
  }

  .lightbox-close {
    position: fixed;
    top: clamp(16px, 3vw, 28px);
    right: clamp(16px, 3vw, 28px);
    background: none;
    border: 1px solid oklch(0.985 0.002 100 / 0.4);
    color: var(--paper);
    width: 36px;
    height: 36px;
    font-size: 14px;
    cursor: pointer;
  }

  .lightbox-close:hover { background: oklch(0.985 0.002 100 / 0.12); }
</style>
